# Copy this file to .env and fill in real values.
# Never commit the real .env — it is gitignored.

# --- Core / local dev ---
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/date48?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# --- Image storage (Cloudflare R2) — needed when images module is integrated ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Phone verification (Twilio Verify) — needed when registration OTP is integrated ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Push notifications (Firebase Cloud Messaging) — needed when notifications module is integrated ---
# FCM_SERVICE_ACCOUNT_* — paste the full service account JSON here (or use a path var per your FCM SDK setup)

# --- Maps / places (Mapbox) — needed when dates module is integrated ---
MAPBOX_ACCESS_TOKEN=

# --- AI suggestions (OpenAI or Anthropic) — needed when ai module is integrated ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Subscriptions / IAP (RevenueCat) — needed when subscriptions module is integrated ---
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# --- Transactional email (Hostinger SMTP) — needed when email notifications are integrated ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
