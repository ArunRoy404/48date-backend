# Copy this file to .env and fill in real values.
# Never commit the real .env — it is gitignored.
# NOTE: Postgres runs in Docker mapped to host port 5433 (docker-compose.yml),
# not 5432 — the DATABASE_URL below already reflects that.

# --- Core ---
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/date48?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) ---
# Generate with: openssl rand -hex 32  (different values for each)
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google sign-in ---
# OAuth 2.0 Client ID used to verify Google ID token signatures (aud claim).
# Without it, /auth/google rejects every token in production and accepts
# unverified payloads only in development (see docs/KNOWN-GAPS.md).
GOOGLE_CLIENT_ID=

# --- Validation ---
# false (local dev): image URLs without a real TLD are accepted, so the local
#   upload fallback (http://localhost:3000/uploads/...) works with P-02.
# true (production): every image URL must be a real public URL.
STRICT_URL_VALIDATION=false

# --- Rate limiting (disabled by default) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Image storage (Cloudflare R2) — local uploads/ fallback when unset ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, no trailing slash (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# --- Phone verification (Twilio Verify) ---
# When all three are set: real SMS OTP. When unset in development: dummy OTP
# 123456 is returned in the API response (dev convenience). In production,
# missing credentials fail CLOSED — sign-in is unavailable, never a dummy code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Used for outgoing SMS notifications (missing from the old .env.example)
TWILIO_PHONE_NUMBER=

# --- Transactional email (Hostinger SMTP) ---
# When all four are set: real OTP emails via SMTP. When unset in development:
# dummy OTP 123456 is returned in the API response (dev convenience). In
# production, missing credentials fail CLOSED — never a dummy code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional explicit From address; defaults to SMTP_USER when unset
SMTP_FROM=

# --- Push notifications (Firebase Cloud Messaging) ---
FCM_SERVICE_ACCOUNT_JSON=

# --- Maps / places (Mapbox) ---
MAPBOX_ACCESS_TOKEN=

# --- AI suggestions (OpenAI or Anthropic) — read by nothing yet ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Subscriptions / IAP (RevenueCat) ---
# Deferred until production hardening (see docs/KNOWN-GAPS.md).
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
