model Match {
  id          String      @id @default(uuid())
  userLowId   String
  userLow     User        @relation("MatchLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHighId  String
  userHigh    User        @relation("MatchHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  status      MatchStatus @default(ACTIVE)
  matchedAt   DateTime    @default(now())
  unmatchedAt DateTime?
  // Product rule (user-confirmed): a match expires 48h after creation unless
  // a first message is sent — the first message nulls this and the match is
  // permanent. Null on matches that were created before this column or are
  // already permanent. The expiry sweep (matches queue) flips these to UNMATCHED.
  expiresAt   DateTime?

  conversation Conversation?
  gameSessions GameSession[]
  datePlans    DatePlan[]
  successStory SuccessStory?

  // userLowId is always the smaller UUID of the pair — enforced in app code,
  // this constraint is what stops Alice+Bob and Bob+Alice becoming two rows
  @@unique([userLowId, userHighId])
  @@map("matches")
}
