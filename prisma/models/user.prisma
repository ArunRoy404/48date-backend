model User {
  // --- Auth / identity ---
  id            String   @id @default(uuid())
  phone         String   @unique
  email         String?  @unique
  passwordHash  String?
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)

  // --- Basic profile ---
  name          String?
  firstName     String?
  lastName      String?
  username      String?  @unique // nickname
  birthDate     DateTime?
  occupation    String?
  gender        Gender?
  interestedIn  Gender? // "who are you here to meet" — same options as gender

  // --- Lifestyle ---
  smoker        HabitFrequency?
  alcohol       HabitFrequency?
  kids          KidsStatus?
  wantsKids     Boolean? // future plan about kids
  lookingFor    LookingFor?

  // --- Location ---
  locations     String[]
  lastLocation  String?

  // --- Body ---
  heightCm      Int?
  weightKg      Int?

  // --- Interests (fixed option lists, validated in app code) ---
  creativity      String[] // Art, Design, Makeup, Photography, Singing
  sports          String[] // Running, Gym, Soccer, Cricket, Tennis, Basketball
  moviesAndDramas String[] // TV Shows, Romance, Comedy, K-Drama, Horror, Thriller, Sci-Fi, Fantasy, Anime, Zombie

  // --- Verification / media ---
  images            Image[]
  selfieUrl         String?
  selfieVerified    Boolean  @default(false) // real verification comes later
  notificationsEnabled Boolean @default(true)

  // --- Billing / meta ---
  subscriptionId String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}
